# Copy to .env and fill in. Get a token at https://huggingface.co/settings/tokens
# (a "Read" token with "Make calls to Inference Providers" permission)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxx

# Chat model served through Hugging Face Inference Providers
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# Leave empty for automatic provider routing, or pin one, e.g. together, nebius, hf-inference
LLM_PROVIDER=
MAX_NEW_TOKENS=700
TEMPERATURE=0.2

# Embeddings: "api" (HF Inference API, no download) or "local" (needs sentence-transformers)
EMBEDDING_BACKEND=api
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval tuning
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
CANDIDATE_POOL=20
RRF_K=60

GRADIO_SERVER_PORT=7860
